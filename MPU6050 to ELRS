#include <Arduino.h>
#include <Wire.h>
#include <MPU6050_tockn.h>
#define POT_PIN 34
#define CRSF_TX_PIN 17
#define CRSF_RX_PIN 16
#define CRSF_BAUD 420000
#define PRINT_INTERVAL_MS 50
#define ROLL_MAX   45.0f
#define PITCH_MAX  45.0f
#define YAW_RATE_MAX 100.0f   // deg/s for yaw 
// Deadband in degrees to ignore small drift
#define DEADBAND 1.5f

MPU6050 mpu(Wire);
HardwareSerial CRSF(2);

#define CRSF_ADDR_MODULE               0xEE
#define CRSF_FRAMETYPE_RC_CHANNELS_PACKED 0x16

uint16_t rc[16];
unsigned long lastPrintMs  = 0;
unsigned long lastLoopMs   = 0;


uint8_t crsf_crc8(const uint8_t *ptr, uint8_t len) {
  uint8_t crc = 0;
  while (len--) {
    crc ^= *ptr++;
    for (uint8_t i = 0; i < 8; i++)
      crc = (crc & 0x80) ? (crc << 1) ^ 0xD5 : (crc << 1);
  }
  return crc;
}

void crsf_pack_channels(uint8_t *payload) {
  uint32_t bitbuf = 0;
  uint8_t  bits   = 0, idx = 0;
  for (int ch = 0; ch < 16; ch++) {
    bitbuf |= ((uint32_t)rc[ch]) << bits;
    bits += 11;
    while (bits >= 8) {
      payload[idx++] = bitbuf & 0xFF;
      bitbuf >>= 8;
      bits   -= 8;
    }
  }
}

void sendCRSF() {
  uint8_t payload[22], frame[26];
  crsf_pack_channels(payload);
  frame[0] = CRSF_ADDR_MODULE;
  frame[1] = 24;
  frame[2] = CRSF_FRAMETYPE_RC_CHANNELS_PACKED;
  memcpy(&frame[3], payload, 22);
  frame[25] = crsf_crc8(&frame[2], 23);
  CRSF.write(frame, 26);
}


uint16_t mapToCRSF(float v, float minV, float maxV) {
  v = constrain(v, minV, maxV);
  return (uint16_t)map((long)(v * 1000), (long)(minV * 1000),
                       (long)(maxV * 1000), 172, 1811);
}

// Apply deadband then map — returns 992 (centre) inside deadband
uint16_t mapWithDeadband(float v, float maxV) {
  if (fabsf(v) < DEADBAND) return 992;
  // shrink range so the jump at deadband edge is smooth-ish
  float sign = (v > 0) ? 1.0f : -1.0f;
  v = sign * (fabsf(v) - DEADBAND);
  return mapToCRSF(v, -(maxV - DEADBAND), (maxV - DEADBAND));
}

void setup() {
  Serial.begin(115200);
  delay(300);

  CRSF.begin(CRSF_BAUD, SERIAL_8N1, CRSF_RX_PIN, CRSF_TX_PIN);

  analogReadResolution(12);
  analogSetPinAttenuation(POT_PIN, ADC_11db);

  Wire.begin(21, 22);
  Wire.setClock(400000);

  mpu.begin();
  Serial.println("Calibrating dont move the gyro");
  mpu.calcGyroOffsets(true);   
  
}

void loop() {
  unsigned long now = micros();
  if (now - lastLoopMs < 2000) return;
  lastLoopMs = now;

  mpu.update();   
  // can adjust as needed 
  float roll  =  mpu.getAngleX();   
  float pitch =  mpu.getAngleY();   
  //Yaw
  float yawRate = mpu.getGyroZ();
  // Throttle
  float throttle = analogRead(POT_PIN) / 4095.0f;

  //Pack channels
  rc[0] = mapWithDeadband(roll,    ROLL_MAX);    // Roll
  rc[1] = mapWithDeadband(pitch,   PITCH_MAX);   // Pitch
  rc[2] = map(throttle * 1000, 0, 1000, 172, 1811); // Throttle
  rc[3] = mapWithDeadband(yawRate, YAW_RATE_MAX); // Yaw
  rc[4] = 1811;  // AUX1 — ARMED
  // rc[4] = 172; // DISARMED
  for (int i = 5; i < 16; i++) rc[i] = 992;

  sendCRSF();

  //Debug print 
  if (millis() - lastPrintMs > PRINT_INTERVAL_MS) {
    lastPrintMs = millis();
    Serial.printf("Angle R/P: %5.1f / %5.1f  YawRate: %6.1f  "
                  "Thr: %4.1f%%  RC: %4u %4u %4u %4u\n",
                  roll, pitch, yawRate,
                  throttle * 100.0f,
                  rc[0], rc[1], rc[2], rc[3]);
  }
}
