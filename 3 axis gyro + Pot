#include <Arduino.h>
#include <Wire.h>
#include <MPU6050_tockn.h>

static const int POT_PIN = 34;
static const int POT_SAMPLES = 6;

MPU6050 mpu(Wire);

int readPotAvg(int pin) {
  long sum = 0;
  for (int i = 0; i < POT_SAMPLES; i++) {
    sum += analogRead(pin);
    delayMicroseconds(40);
  }
  return (int)(sum / POT_SAMPLES);
}

static inline float rad2deg(float r) { return r * 57.2957795f; }

float pitch0 = 0, roll0 = 0, yaw0 = 0;
float yawDeg = 0;
unsigned long lastUs = 0;

void setup() {
  Serial.begin(115200);
  delay(300);

  // Pot
  analogReadResolution(12);
  analogSetPinAttenuation(POT_PIN, ADC_11db);

  // I2C (MPU powered from 3.3V)
  Wire.begin(21, 22);
  Wire.setClock(400000);

  mpu.begin();

  Serial.println("Warming up (keep still)...");
  for (int i = 0; i < 200; i++) { mpu.update(); delay(10); }

  Serial.println("Calibrating gyro offsets (DO NOT MOVE)...");
  mpu.calcGyroOffsets(true);

  // Capture zero baseline using accel-based pitch/roll and gyro yaw
  Serial.println("Capturing zero (still)...");
  float sp = 0, sr = 0;
  const int N = 80;
  for (int i = 0; i < N; i++) {
    mpu.update();

    float ax = mpu.getAccX();
    float ay = mpu.getAccY();
    float az = mpu.getAccZ();

    // Pitch/Roll from accelerometer (in degrees)
    float pitch = rad2deg(atan2f(-ax, sqrtf(ay * ay + az * az)));
    float roll  = rad2deg(atan2f( ay, az ));

    sp += pitch;
    sr += roll;

    delay(5);
  }
  pitch0 = sp / N;
  roll0  = sr / N;

  yawDeg = 0.0f;
  yaw0 = 0.0f; 

  lastUs = micros();

  Serial.println("Ready: starts at 0,0,0 (Pitch/Roll accel, Yaw gyro-integrated)");
}

void loop() {
  mpu.update();

  // time step for yaw integration
  unsigned long nowUs = micros();
  float dt = (nowUs - lastUs) / 1000000.0f;
  lastUs = nowUs;

  // Throttle
  int raw = readPotAvg(POT_PIN);
  float throttle = (raw / 4095.0f) * 100.0f;

  // Accel readings (g)
  float ax = mpu.getAccX();
  float ay = mpu.getAccY();
  float az = mpu.getAccZ();

  // Stable pitch/roll from accel
  float pitch = -rad2deg(atan2f(-ax, sqrtf(ay * ay + az * az))) - pitch0;
  float roll  = rad2deg(atan2f( ay, az )) - roll0;

  // Yaw from gyro Z rate integration (deg/s * s = deg)
  float gz = mpu.getGyroZ();      // deg/s 
  yawDeg += gz * dt;              // relative yaw

  Serial.print("Throttle: ");
  Serial.print(throttle, 1);
  Serial.print("% (raw ");
  Serial.print(raw);
  Serial.print(") | Pitch: ");
  Serial.print(pitch, 2);
  Serial.print(" Roll: ");
  Serial.print(roll, 2);
  Serial.print(" Yaw: ");
  Serial.print(yawDeg, 2);
  Serial.println();

  delay(10);
}
// Pin connections/Comments 
// If you made it this far, please note that since the MPU6050 is a 6 axis sensor the yaw will drift meaning after sometime readings will NOT be accurate 
// ESP32 GPIO21 (SDA) → MPU6050 SDA
// ESP32 GPIO22 (SCL) → MPU6050 SCL
// ESP32 3.3V → MPU6050 VCC (use 3.3V, not 5V, unless your module explicitly supports it)
// ESP32 GND → MPU6050 GND
//Pot one end → ESP32 3.3V
// Pot other end → ESP32 GND
// Pot middle (wiper) → ESP32 GPIO34 (ADC input)
